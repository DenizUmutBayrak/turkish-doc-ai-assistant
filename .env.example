# Gelecek LLM entegrasyonu için isteğe bağlı ayarlar; mevcut aşamada anahtar gerekmez.
# Gerçek anahtarı yalnızca yerel .env dosyanıza ekleyin, bu örnek dosyaya yazmayın.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Uygulama ayarları
API_BASE_URL=http://localhost:8000
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=300
MAX_SESSION_FILES=10
MAX_SESSION_CHUNKS=2000
MAX_ACTIVE_SESSIONS=100
SESSION_TTL_MINUTES=60
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_QUERY_PREFIX=query:
EMBEDDING_DOCUMENT_PREFIX=passage:

# Yerel Ollama sohbet modeli; API anahtarı veya ücretli servis gerekmez.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_THINK=false
OLLAMA_NUM_PREDICT=512
OLLAMA_ALLOW_REMOTE=false
RAG_MAX_CONTEXT_CHARS=16000
RAG_MAX_QUESTION_CHARS=2000
